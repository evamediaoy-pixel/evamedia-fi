{
  "version": 2,
  "builds": [
    {
      "src": "api-instagram-pinned.js",
      "use": "@vercel/node"
    },
    {
      "src": "**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/instagram-pinned",
      "dest": "/api-instagram-pinned.js"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}